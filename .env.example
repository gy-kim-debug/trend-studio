# Supabase project settings (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# A long random secret for ChatGPT Action and dashboard access (server only)
TREND_STUDIO_API_TOKEN=

# 관리자 이메일/비밀번호 로그인 (Supabase Authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 이 이메일과 일치하는 인증 사용자만 카드뉴스 API에 접근 가능
TREND_STUDIO_ADMIN_EMAIL=

# AI trend discovery. OpenAI API billing is independent from ChatGPT Plus.
OPENAI_API_KEY=
OPENAI_TREND_MODEL=gpt-6-astra
# Required for Vercel's 08:00 KST daily cron (23:00 UTC).
CRON_SECRET=
